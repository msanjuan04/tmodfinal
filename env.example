# Copia este fichero a .env para desarrollo local. NUNCA versiones .env.
# En producción (DigitalOcean) estas variables se configuran en el panel de la app
# y tienen prioridad sobre el fichero local.

NODE_ENV=development
PORT=4000

# URL pública del portal. En producción DEBE ser https://
CLIENT_APP_URL=http://localhost:5173

# Supabase (servidor)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role: acceso total a la base de datos. Solo en el servidor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DEFAULT_PROJECT_SLUG=

# Supabase (frontend, opcional; el portal habla con la API de Express)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Sesiones: mínimo 32 caracteres en producción. Genera uno con: openssl rand -base64 48
SESSION_SECRET=
# SESSION_COOKIE_SAME_SITE=lax
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (correo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@terrazea.com
RESEND_BCC=
RESEND_AUDIENCE_ID=
# true en desarrollo para no enviar correos reales
RESEND_DRY_RUN=true

# Enlace externo para la petición de valoración al cerrar un proyecto (opcional)
FEEDBACK_REVIEW_URL=
